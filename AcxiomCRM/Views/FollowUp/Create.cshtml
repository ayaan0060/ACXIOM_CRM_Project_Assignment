@model FollowUp
@{ ViewData["Title"] = "New Follow-Up"; }

<h4 class="mb-3">New Follow-Up</h4>
<div class="card p-4" style="max-width:560px">
<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Subject" class="form-label"></label>
        <input asp-for="Subject" class="form-control" />
        <span asp-validation-for="Subject" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FollowUpDate" class="form-label"></label>
        <input asp-for="FollowUpDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FollowUpType" class="form-label"></label>
        <select asp-for="FollowUpType" class="form-select">
            <option>Call</option><option>Meeting</option><option>Email</option><option>Task</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="RelatedType" class="form-label">Related To</label>
        <select asp-for="RelatedType" class="form-select">
            <option>Customer</option><option>Lead</option><option>Opportunity</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="RelatedId" class="form-label">Related ID</label>
        <input asp-for="RelatedId" class="form-control" type="number" min="1" />
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
    </div>
    <button class="btn btn-success">Save</button>
    <a href="/FollowUp" class="btn btn-link">Cancel</a>
</form>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
