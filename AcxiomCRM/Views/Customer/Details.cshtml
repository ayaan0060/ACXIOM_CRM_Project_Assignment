@model Customer
@{ ViewData["Title"] = "Customer Details"; }

<h4 class="mb-3">Customer Details</h4>
<div class="card p-4" style="max-width:560px">
    <dl class="row">
        <dt class="col-4">Name</dt><dd class="col-8">@Model.Name</dd>
        <dt class="col-4">Email</dt><dd class="col-8">@Model.Email</dd>
        <dt class="col-4">Phone</dt><dd class="col-8">@Model.Phone</dd>
        <dt class="col-4">Company</dt><dd class="col-8">@Model.CompanyName</dd>
        <dt class="col-4">Address</dt><dd class="col-8">@Model.Address</dd>
        <dt class="col-4">Status</dt><dd class="col-8"><span class="badge bg-@(Model.Status=="Active"?"success":"secondary")">@Model.Status</span></dd>
        <dt class="col-4">Created</dt><dd class="col-8">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
    </dl>
    <a href="/Customer/Edit/@Model.Id" class="btn btn-primary btn-sm me-2">Edit</a>
    <a href="/Customer" class="btn btn-outline-secondary btn-sm">Back</a>
</div>
