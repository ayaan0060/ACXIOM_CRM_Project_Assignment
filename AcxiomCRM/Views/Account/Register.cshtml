@{
    Layout = null;
    ViewData["Title"] = "Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - AcxiomCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh">
<div class="card p-4 shadow" style="width:380px">
    <h4 class="mb-3 text-center">Register</h4>
    <form method="post" action="/Account/Register">
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                { <div>@e.ErrorMessage</div> }
            </div>
        }
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="fullName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Password <small class="text-muted">(min 8 chars, 1 uppercase, 1 digit)</small></label>
            <input type="password" name="password" class="form-control" required minlength="8" />
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <select name="role" class="form-select">
                <option value="SalesExecutive">Sales Executive</option>
                <option value="Manager">Manager</option>
            </select>
        </div>
        <button class="btn btn-success w-100">Register</button>
        <div class="mt-3 text-center"><a href="/Account/Login">Back to Login</a></div>
    </form>
</div>
</body>
</html>
