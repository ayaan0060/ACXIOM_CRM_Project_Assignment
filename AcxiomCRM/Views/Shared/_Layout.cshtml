<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background: #f5f6fa; }
        .sidebar { width: 220px; min-height: 100vh; background: #1a2340; }
        .sidebar a { color: #b0bec5; text-decoration: none; display: block; padding: 10px 20px; }
        .sidebar a:hover, .sidebar a.active { color: #fff; background: #2d3b62; }
        .sidebar .brand { color: #fff; font-size: 1.2rem; font-weight: 700; padding: 18px 20px; border-bottom: 1px solid #2d3b62; }
        .main-content { flex: 1; padding: 24px; }
        .card { border: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .nav-section { color: #607d8b; font-size: .75rem; padding: 12px 20px 4px; text-transform: uppercase; }
    </style>
</head>
<body>
<div class="d-flex">
    @if (User.Identity?.IsAuthenticated == true)
    {
    <div class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-grid-3x3-gap-fill"></i> AcxiomCRM</div>
        <div class="nav-section">Main</div>
        <a href="/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
        <div class="nav-section">CRM</div>
        <a href="/Customer"><i class="bi bi-people me-2"></i>Customers</a>
        <a href="/Lead"><i class="bi bi-funnel me-2"></i>Leads</a>
        <a href="/Opportunity"><i class="bi bi-trophy me-2"></i>Opportunities</a>
        <a href="/FollowUp"><i class="bi bi-calendar-check me-2"></i>Follow-Ups</a>
        @if (User.IsInRole("Admin"))
        {
        <div class="nav-section">Admin</div>
        <a href="/UserManagement"><i class="bi bi-person-gear me-2"></i>Users</a>
        <a href="/AuditLog"><i class="bi bi-shield-check me-2"></i>Audit Log</a>
        }
        <div class="mt-auto p-3">
            <form method="post" action="/Account/Logout">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-light btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
            </form>
        </div>
    </div>
    }
    <div class="main-content">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
