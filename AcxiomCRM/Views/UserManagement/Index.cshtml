@model IEnumerable<AppUser>
@{ ViewData["Title"] = "Users"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Users</h4>
    <a href="/UserManagement/Create" class="btn btn-primary btn-sm">+ New User</a>
</div>

<form class="d-flex mb-3 gap-2" method="get">
    <input type="text" name="search" class="form-control" placeholder="Search email or name..." value="@ViewBag.Search" style="max-width:300px" />
    <button class="btn btn-outline-secondary btn-sm">Search</button>
</form>

<div class="card">
<table class="table table-hover mb-0">
    <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Status</th><th>Lockout</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td><span class="badge bg-@(u.IsActive?"success":"secondary")">@(u.IsActive?"Active":"Inactive")</span></td>
            <td>@(u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now ? "Locked" : "OK")</td>
            <td>
                <form method="post" action="/UserManagement/ToggleActive" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-warning" onclick="return confirm('Toggle active status?')">@(u.IsActive?"Deactivate":"Activate")</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">No users found.</td></tr> }
    </tbody>
</table>
</div>
